# ==========================================
# HomeLearn - 家庭智能学习平台
# ==========================================

# 开发环境
NODE_ENV=development

# 数据库 (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homelearn?schema=public"

# 认证
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# AI API 配置
# DeepSeek (首选)
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_API_URL="https://api.deepseek.com"

# 通义千问 (备选1)
DASHSCOPE_API_KEY="your-dashscope-api-key"
DASHSCOPE_API_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 智谱GLM (备选2)
ZHIPU_API_KEY="your-zhipu-api-key"
ZHIPU_API_URL="https://open.bigmodel.cn/api/paas/v4"

# AI 配置
AI_MODEL="deepseek-chat"
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# 微软 Azure 语音
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="eastasia"

# Mathpix 公式识别
MATHPIX_APP_ID="your-mathpix-app-id"
MATHPIX_APP_KEY="your-mathpix-app-key"

# 百度 OCR
BAIDU_OCR_API_KEY="your-baidu-ocr-api-key"
BAIDU_OCR_SECRET_KEY="your-baidu-ocr-secret-key"

# MinIO 文件存储
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="homelearn"
MINIO_USE_SSL="false"

# Redis (可选，用于缓存)
REDIS_URL="redis://localhost:6379"

# CORS
CORS_ORIGIN="http://localhost:3000"

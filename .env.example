# ==========================================
# HomeLearn - 家庭智能学习平台
# ==========================================

# 开发环境
NODE_ENV=development

# 数据库 (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homelearn?schema=public"

# 认证
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# AI API 配置
# DeepSeek (首选)
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_API_URL="https://api.deepseek.com"

# 通义千问 (备选1)
DASHSCOPE_API_KEY="your-dashscope-api-key"
DASHSCOPE_API_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 智谱GLM (备选2)
ZHIPU_API_KEY="your-zhipu-api-key"
ZHIPU_API_URL="https://open.bigmodel.cn/api/paas/v4"

# CodeBuddy Craft (内置实现，无需启动独立服务)
# 支持模型（Max模式）:
#   内置: Auto
#   Ily: Ily3-Preview (限免试用)
#   智谱: GLM-5v-Turbo, GLM-5.1, GLM-5.0-Turbo
#   Kimi: Kimi-K2.6, Kimi-K2.5
#   MiniMax: MiniMax-M2.7
#   DeepSeek: DeepSeek-V4-Flash, DeepSeek-V3.2
#
# 使用方式: CODEBUDDY_MODEL=auto | CODEBUDDY_MODEL=deepseek-v4-flash
#
# 凭证存储在 .codebuddy_creds 目录（与 codebuddy2api 兼容）
# 使用 scripts/add-codebuddy-credential.js 添加凭证
CODEBUDDY_ENABLED="false"
CODEBUDDY_API_ENDPOINT="https://www.codebuddy.ai"
CODEBUDDY_CREDS_DIR=".codebuddy_creds"

# 默认模型配置
# 可选值: auto(自动), ily3-preview, glm-5v-turbo, glm-5.1, glm-5.0-turbo,
#         kimi-k2.6, kimi-k2.5, minimax-m2.7, deepseek-v4-flash, deepseek-v3.2
CODEBUDDY_MODEL="auto"

# 可用模型列表（用于轮换或展示）
CODEBUDDY_MODELS="auto,ily3-preview,glm-5v-turbo,glm-5.1,glm-5.0-turbo,kimi-k2.6,kimi-k2.5,minimax-m2.7,deepseek-v4-flash,deepseek-v3.2"
CODEBUDDY_ROTATION_COUNT="1"

# AI 配置
AI_MODEL="deepseek-chat"
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# 举一反三自动生成配置
AUTO_GENERATE_SIMILAR="true"          # 错题入库时自动生成变式题
INTERNAL_API_SECRET="homelearn-internal"  # 内部API调用密钥

# 微软 Azure 语音
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="eastasia"

# Mathpix 公式识别
MATHPIX_APP_ID="your-mathpix-app-id"
MATHPIX_APP_KEY="your-mathpix-app-key"

# 百度 OCR
BAIDU_OCR_API_KEY="your-baidu-ocr-api-key"
BAIDU_OCR_SECRET_KEY="your-baidu-ocr-secret-key"

# MinIO 文件存储
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="homelearn"
MINIO_USE_SSL="false"

# Redis (可选，用于缓存)
REDIS_URL="redis://localhost:6379"

# CORS
CORS_ORIGIN="http://localhost:3000"

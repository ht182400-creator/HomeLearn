// HomeLearn - Prisma Schema
// 版本: V1.0 | 日期: 2026-05-11

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户与认证
// ============================================

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  username      String        @unique
  passwordHash  String
  role          UserRole      @default(PARENT)
  avatar        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // ========== Phase 2 扩展字段 ==========
  phone         String?       // 手机号
  nickname      String?       // 昵称
  lastLoginAt   DateTime?     // 最后登录时间
  loginCount    Int           @default(0)  // 登录次数
  status        String        @default("ACTIVE")  // 状态: ACTIVE, BANNED, PENDING
  extra         Json?         // 备用扩展字段
  // =====================================
  
  // 关联
  children        ChildAccount[]
  questions       Question[]
  speechTemplates SpeechTemplate[]
  recordings      Recording[]
  accounts        Account[]
  sessions        Session[]
  tasks           PracticeTask[]  // 创建的练习任务
  
  @@map("users")
}

enum UserRole {
  PARENT      // 家长
  ADMIN       // 系统管理员(预留)
}

enum Gender {
  MALE        // 男
  FEMALE      // 女
  OTHER       // 其他
}

enum QuestionSource {
  MANUAL       // 手动创建
  AI_GENERATE  // AI生成
  IMPORT       // 批量导入
  COPY         // 复制
}

enum AuthStatus {
  PENDING    // 待审核
  APPROVED   // 已通过
  REJECTED   // 已驳回
}

// NextAuth 适配器
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// 孩子账户
// ============================================

model ChildAccount {
  id            String        @id @default(cuid())
  userId        String
  nickname      String
  // ========== 孩子独立登录字段 ==========
  username      String?       @unique  // 孩子独立登录的用户名
  passwordHash  String?       // 孩子独立登录的密码
  // =====================================
  grade         Grade?
  avatar        String?
  preferences   Json?         // 学习偏好设置
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // ========== Phase 1 扩展字段 ==========
  gender        Gender?       // 性别
  birthday      DateTime?     // 生日
  school        String?       // 学校
  className     String?       // 班级
  totalStudyTime Int          @default(0)  // 累计学习时间(分钟)
  totalPractice  Int          @default(0)  // 累计练习次数
  totalCorrect   Int          @default(0)  // 累计正确数
  extra         Json?         // 备用扩展字段
  // =====================================
  
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wrongQuestions WrongQuestion[]
  speechResults  SpeechResult[]
  reviewRecords  ReviewRecord[]
  practiceRecords PracticeRecord[]
  tasks         PracticeTask[]  // 收到的练习任务
  chatSessions  ChatSession[]   // AI 对话会话
  goals         LearningGoal[]  // 学习目标
  practiceSessions PracticeSession[]  // 练习会话
  reports       LearningReport[]  // 学习报告
  similarQuestions SimilarQuestion[]  // 举一反三变式题
  
  @@index([userId])
  @@map("child_accounts")
}

enum Grade {
  PRIMARY_1    // 小学一年级
  PRIMARY_2
  PRIMARY_3
  PRIMARY_4
  PRIMARY_5
  PRIMARY_6
  MIDDLE_1     // 初一
  MIDDLE_2
  MIDDLE_3
  HIGH_1       // 高一
  HIGH_2
  HIGH_3
}

// ============================================
// 学科与知识点
// ============================================

model Subject {
  id            String        @id @default(cuid())
  name          String        // 学科名称: 数学、英语、语文...
  code          String        @unique  // 代码: MATH, ENGLISH, CHINESE...
  icon          String?       // 图标URL
  color         String?       // 主题色
  order         Int          @default(0)
  
  // ========== Phase 3 扩展字段 ==========
  description   String?       // 学科描述
  isActive      Boolean       @default(true)  // 是否启用
  extra         Json?         // 备用扩展字段
  // =====================================
  
  questions     Question[]
  topics        Topic[]
  practiceTasks PracticeTask[]  // 关联的练习任务
  goals         LearningGoal[]  // 学习目标
  practiceSessions PracticeSession[]  // 练习会话
  
  @@map("subjects")
}

model Topic {
  id            String        @id @default(cuid())
  subjectId     String
  name          String        // 知识点名称
  code          String?       // 知识点编码
  parentId      String?       // 父级知识点ID(支持多级)
  level         Int           @default(1)
  order         Int          @default(0)
  
  // ========== Phase 2 扩展字段 ==========
  description   String?       // 知识点描述
  difficulty    Int?          // 难度等级 1-5
  keywords      String[]      // 关键词搜索
  isActive      Boolean       @default(true)  // 是否启用
  usageCount    Int           @default(0)  // 使用次数
  extra         Json?         // 备用扩展字段
  // =====================================
  
  subject       Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent        Topic?       @relation("TopicHierarchy", fields: [parentId], references: [id])
  children      Topic[]      @relation("TopicHierarchy")
  questionTopics QuestionTopic[]
  
  @@index([subjectId])
  @@index([parentId])
  @@map("topics")
}

model Tag {
  id            String          @id @default(cuid())
  userId        String
  name          String
  color         String          @default("#3B82F6")
  type          TagType         @default(CUSTOM)
  createdAt     DateTime        @default(now())
  
  // ========== Phase 3 扩展字段 ==========
  description   String?         // 标签描述
  usageCount    Int             @default(0)  // 使用次数
  extra         Json?           // 备用扩展字段
  // =====================================
  
  questionTags  QuestionTag[]
  
  @@unique([userId, name])
  @@map("tags")
}

enum TagType {
  CUSTOM       // 自定义标签
  DIFFICULTY   // 难度标签
  ERROR_TYPE   // 错因标签
}

// ============================================
// 题目系统
// ============================================

model Question {
  id            String          @id @default(cuid())
  userId        String
  subjectId     String
  type          QuestionType
  difficulty    Int             @default(3)  // 1-5星难度
  content       Json            // 富文本内容
  answer        Json            // 答案
  analysis      Json?           // 题目解析
  isPublic      Boolean         @default(false)
  version       Int             @default(1)
  status        QuestionStatus  @default(DRAFT)
  metadata      Json?           // 扩展字段
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // ========== Phase 1 扩展字段 ==========
  grade         Grade?          // 适用年级，不填=通用题
  source        QuestionSource  @default(MANUAL)  // 来源
  usageCount    Int             @default(0)  // 被练习使用次数
  wrongCount    Int             @default(0)  // 被错题本收录次数
  likeCount     Int             @default(0)  // 点赞数
  collectCount  Int             @default(0)  // 收藏数
  authStatus    AuthStatus      @default(APPROVED)  // 审核状态
  rejectReason  String?         // 驳回原因
  standardTime  Int?            // 标准作答时间(秒)
  extra         Json?           // 备用扩展字段
  // =====================================
  
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject           @relation(fields: [subjectId], references: [id])
  versions        QuestionVersion[]
  wrongQuestions  WrongQuestion[]
  questionTopics  QuestionTopic[]
  questionTags    QuestionTag[]
  attachments     Attachment[]
  recordings      Recording[]
  practiceAnswers PracticeAnswer[]  // 练习答案
  similarQuestions SimilarQuestion[]  // 举一反三变式题
  
  @@index([userId])
  @@index([subjectId])
  @@index([difficulty])
  @@index([type])
  @@index([grade])
  @@map("questions")
}

enum QuestionType {
  SINGLE_CHOICE    // 单选题
  MULTIPLE_CHOICE  // 多选题
  TRUE_FALSE       // 判断题
  FILL_BLANK       // 填空题
  SHORT_ANSWER     // 简答题
  CALCULATION      // 计算题
  PROOF            // 证明题
  COMPREHENSIVE    // 综合题 (与Zod验证器一致)
  FREE_RESPONSE    // 解答题 (与Zod验证器一致)
  OTHER            // 其他题型 (与Zod验证器一致)
  // 兼容旧值 (后续迁移后删除)
  COMPOSITION      // 作文 (旧值，兼容用)
  READING          // 阅读理解 (旧值，兼容用)
  LISTENING        // 听力题 (旧值，兼容用)
}

enum QuestionStatus {
  DRAFT       // 草稿
  PUBLISHED   // 已发布
  ARCHIVED    // 已归档
}

model QuestionVersion {
  id            String        @id @default(cuid())
  questionId    String
  version       Int
  content       Json
  answer        Json
  analysis      Json?
  createdAt     DateTime      @default(now())
  
  // ========== Phase 3 扩展字段 ==========
  changeReason  String?       // 变更原因
  createdBy     String?       // 创建人ID
  extra         Json?         // 备用扩展字段
  // =====================================
  
  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([questionId, version])
  @@index([questionId])
  @@map("question_versions")
}

model QuestionTopic {
  questionId    String
  topicId       String
  weight        Float         @default(1.0)
  
  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic         Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  @@id([questionId, topicId])
  @@map("question_topics")
}

model QuestionTag {
  questionId    String
  tagId         String
  
  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag           Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([questionId, tagId])
  @@map("question_tags")
}

model Attachment {
  id            String          @id @default(cuid())
  questionId    String
  type          AttachmentType
  filename      String
  url           String
  size          Int
  mimeType      String
  metadata      Json?
  createdAt     DateTime        @default(now())
  
  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@index([questionId])
  @@map("attachments")
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  GEOMETRY
  FORMULA
}

// ============================================
// 错题本系统
// ============================================

model WrongQuestion {
  id              String          @id @default(cuid())
  childId         String
  questionId      String
  source          WrongSource     @default(MANUAL)
  wrongAnswer     Json?
  mistakeReason   String?
  notes           String?
  mastered        Boolean         @default(false)
  masteryLevel    Int             @default(0)    // 0-5
  attempts        Int             @default(0)
  lastAttempt     DateTime?
  reviewCount     Int             @default(0)
  lastReview      DateTime?
  nextReview      DateTime?       // 艾宾浩斯下次复习时间
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // ========== Phase 3 扩展字段 ==========
  wrongType       String?         // 错因类型
  aiAnalysis      Json?           // AI分析结果
  parentFeedback  String?         // 家长反馈
  extra           Json?           // 备用扩展字段
  // =====================================
  
  child           ChildAccount    @relation(fields: [childId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id])
  reviews         ReviewRecord[]
  
  @@index([childId])
  @@index([questionId])
  @@index([nextReview])
  @@map("wrong_questions")
}

enum WrongSource {
  MANUAL        // 手动添加
  PRACTICE      // 练习自动录入
  EXAM          // 考试录入
  IMPORT        // 批量导入
}

model ReviewRecord {
  id              String          @id @default(cuid())
  wrongQuestionId String
  childId         String
  reviewed        Boolean         // 是否真正掌握
  confidence      Int?            // 自信心评分 1-5
  notes           String?
  aiHelpUsed      Boolean         @default(false)
  reviewMethod    ReviewMethod?
  timeSpent       Int?            // 用时(秒)
  reviewedAt      DateTime        @default(now())
  
  // ========== Phase 3 扩展字段 ==========
  understandingLevel Int?         // 理解程度 1-5
  difficultyRating  Int?         // 题目难度评分 1-5
  extra             Json?        // 备用扩展字段
  // =====================================
  
  wrongQuestion   WrongQuestion   @relation(fields: [wrongQuestionId], references: [id], onDelete: Cascade)
  child           ChildAccount    @relation(fields: [childId], references: [id])
  
  @@index([wrongQuestionId])
  @@index([childId])
  @@map("review_records")
}

enum ReviewMethod {
  SELF            // 自主复习
  AI_TUTOR        // AI讲解
  PARENT_TEACH    // 家长讲解
  VIDEO           // 视频讲解
  PRACTICE        // 练习巩固
}

// ============================================
// 练习记录
// ============================================

model PracticeRecord {
  id              String          @id @default(cuid())
  childId         String
  subjectId       String
  type            PracticeType
  totalQuestions  Int
  correctCount    Int
  duration        Int?            // 用时(秒)
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  
  // ========== Phase 1 扩展字段 ==========
  wrongQuestionIds String[]       // 本次错题ID列表
  score            Float?         // 总分
  topicSummary     Json?          // 知识点掌握情况
  extra            Json?          // 备用扩展字段
  // =====================================
  
  child           ChildAccount    @relation(fields: [childId], references: [id])
  
  @@index([childId])
  @@map("practice_records")
}

// ============================================
// 练习任务系统（家长推题）
// ============================================

model PracticeTask {
  id                   String        @id @default(cuid())
  parentId             String        // 家长ID (关联 User)
  childId              String        // 孩子ID (关联 ChildAccount)
  subjectId            String?       // 科目ID (关联 Subject, 可选)
  title                String        // 任务名称
  description          String?       // 任务描述/备注
  questionIds          String[]      // 题目ID列表
  questionCount        Int           @default(0)  // 题目数量
  dueDate              DateTime?     // 截止日期 (可选，不填时默认今天+7天)
  status               TaskStatus    @default(PENDING)  // 任务状态
  allowSkip            Boolean       @default(true)     // 是否允许跳过题目
  requireConfirmation  Boolean       @default(false)    // 是否需要家长确认完成
  completedAt          DateTime?     // 完成时间
  answers              Json?         // 孩子的答案记录 {questionId: answer}
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  
  // 关联
  parent              User          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child               ChildAccount  @relation(fields: [childId], references: [id], onDelete: Cascade)
  subject             Subject?      @relation(fields: [subjectId], references: [id])
  
  @@index([parentId])
  @@index([childId])
  @@index([status])
  @@map("practice_tasks")
}

// ============================================
// 练习会话 (PracticeSession) - 孩子练习过程中的会话
// ============================================

model PracticeSession {
  id            String        @id @default(cuid())
  childId       String
  subjectId     String?
  taskId        String?       // 可选关联的任务
  status        SessionStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  source        String?       // 来源
  questionCount Int           @default(0)  // 题目数量
  correctCount  Int           @default(0)  // 正确数
  wrongCount    Int           @default(0)  // 错误数
  accuracy      Int?          // 正确率(%)
  totalTimeSpent Int?         // 总用时(秒)
  
  // 关系
  child         ChildAccount  @relation(fields: [childId], references: [id])
  subject       Subject?      @relation(fields: [subjectId], references: [id])
  answers       PracticeAnswer[]
  
  @@index([childId])
  @@map("practice_sessions")
}

model PracticeAnswer {
  id            String      @id @default(cuid())
  sessionId     String
  questionId    String
  answer        String?     @db.Text  // 孩子的答案
  isCorrect     Boolean?
  timeSpent     Int?        // 耗时(秒)
  createdAt     DateTime    @default(now())
  
  // 关系
  session       PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])
  
  @@index([sessionId])
  @@map("practice_answers")
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum TaskStatus {
  PENDING         // 待完成
  IN_PROGRESS    // 进行中
  PENDING_CONFIRM // 待家长确认
  COMPLETED      // 已完成
  OVERDUE        // 已逾期
  CANCELLED      // 已取消
}

// ============================================
// 站内通知系统
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String   // 接收通知的用户ID (User 或 ChildAccount)
  userType  UserType @default(USER)  // 用户类型：家长或孩子
  type      NotificationType  // 通知类型
  title     String
  content   String
  taskId    String?  // 关联任务ID
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

enum UserType {
  USER   // 家长账户
  CHILD  // 孩子账户
}

enum NotificationType {
  TASK_ASSIGNED     // 新任务通知
  TASK_SUBMITTED    // 任务已提交
  TASK_CONFIRMED    // 任务已确认完成
  TASK_REMINDER     // 任务到期提醒
  TASK_OVERDUE      // 任务已逾期
}

enum PracticeType {
  FREE        // 自由练习
  EXAM        // 考试模式
  REVIEW      // 错题复习
  TARGETED    // 针对性练习
}

// ============================================
// 语音评测系统
// ============================================

model SpeechTemplate {
  id            String          @id @default(cuid())
  userId        String
  title         String
  content       String
  language      String          @default("en-US")
  type          SpeechType
  difficulty    Int?
  tags          String[]
  audioUrl      String?
  usageCount    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // ========== Phase 3 扩展字段 ==========
  phoneticNotes    String?       // 发音技巧说明
  exampleSentences String[]      // 例句
  pronunciationTips String?      // 发音提示
  isFavorite       Boolean       @default(false)  // 是否收藏
  extra            Json?         // 备用扩展字段
  // =====================================
  
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  results       SpeechResult[]
  
  @@index([userId])
  @@map("speech_templates")
}

enum SpeechType {
  WORD           // 单词
  SENTENCE       // 句子
  PARAGRAPH      // 段落
  DIALOGUE       // 对话
  PRONUNCIATION  // 发音练习
}

model SpeechResult {
  id              String          @id @default(cuid())
  templateId      String
  childId         String
  score           Float           // 总分 0-100
  accuracy        Float?
  fluency         Float?
  completeness    Float?
  prosody         Float?
  phonemeDetail   Json?
  feedback        Json?
  audioUrl        String?
  duration        Int?
  createdAt       DateTime        @default(now())
  
  // ========== Phase 3 扩展字段 ==========
  wordDetails     Json?           // 单词详情
  problemPhonemes String[]        // 问题音素
  improvementTips String?         // 改进建议
  comparisonHistory Json?         // 历史对比
  extra           Json?           // 备用扩展字段
  // =====================================
  
  template        SpeechTemplate  @relation(fields: [templateId], references: [id])
  child           ChildAccount    @relation(fields: [childId], references: [id])
  
  @@index([templateId])
  @@index([childId])
  @@map("speech_results")
}

// ============================================
// 家长讲解系统
// ============================================

model Recording {
  id            String          @id @default(cuid())
  userId        String
  questionId    String?
  type          RecordingType
  title         String
  description   String?
  url           String
  thumbnail     String?
  duration      Int?
  size          Int?
  views         Int             @default(0)
  likes         Int             @default(0)
  isPublic      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  
  // ========== Phase 3 扩展字段 ==========
  category      String?         // 分类
  isFavorite    Boolean         @default(false)  // 是否收藏
  downloadCount Int             @default(0)  // 下载次数
  shareCount    Int             @default(0)  // 分享次数
  source        String?         // 来源
  extra         Json?           // 备用扩展字段
  // =====================================
  
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question?       @relation(fields: [questionId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([questionId])
  @@map("recordings")
}

enum RecordingType {
  VIDEO
  AUDIO
  SCREEN_RECORD
}

// ============================================
// 文言文系统
// ============================================

model ChineseText {
  id            String          @id @default(cuid())
  title         String
  author        String?
  dynasty       String?
  content       String          // 原文
  pinyin        String?         // 拼音
  translation   String?         // 白话文翻译
  annotation    Json?           // 注音和夹注
  layout        LayoutType      @default(HORIZONTAL)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // ========== Phase 3 扩展字段 ==========
  background    String?         // 创作背景
  appreciation  String?         // 文学赏析
  relatedTexts  String[]        // 相关篇目
  difficulty    Int?            // 难度等级 1-5
  readingTime   Int?            // 预计阅读时间(分钟)
  extra         Json?           // 备用扩展字段
  // =====================================
  
  @@map("chinese_texts")
}

enum LayoutType {
  HORIZONTAL    // 横排
  VERTICAL      // 竖排(古典)
}

// ============================================
// AI 对话记录
// ============================================

model AIConversation {
  id            String          @id @default(cuid())
  childId       String
  subjectId     String?
  messages      Json            // 对话历史
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // ========== Phase 2 扩展字段 ==========
  title         String?         // 对话标题
  summary       String?         // 对话摘要
  messageCount  Int             @default(0)  // 消息数量
  lastMessageAt DateTime?       // 最后消息时间
  subjectName   String?         // 科目名称
  isFavorite    Boolean        @default(false)  // 是否收藏
  isResolved    Boolean         @default(false)  // 是否已解决
  extra         Json?          // 备用扩展字段
  // =====================================
  
  @@index([childId])
  @@map("ai_conversations")
}

// ============================================
// AI 对话会话 (ChatSession)
// ============================================

model ChatSession {
  id            String        @id @default(cuid())
  childId       String
  parentId      String        // 孩子的家长ID，用于权限验证
  subject       String?       // 当前会话的学科
  summary       String        @default("新对话")
  messageCount  Int           @default(0)
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // 关系
  child         ChildAccount  @relation(fields: [childId], references: [id])
  messages      ChatMessage[]

  @@index([childId])
  @@index([parentId])
  @@map("chat_sessions")
}

// ============================================
// AI 对话消息 (ChatMessage)
// ============================================

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  role          String      // "user" | "assistant" | "system"
  content       String      @db.Text
  tokens        Int?        // 消息token数
  createdAt     DateTime    @default(now())

  // 关系
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

// ============================================
// 学习目标系统 (LearningGoal)
// ============================================

model LearningGoal {
  id            String        @id @default(cuid())
  childId       String
  parentId      String        // 家长ID
  title         String        // 目标标题
  description   String?       // 目标描述
  type          GoalType      // 目标类型
  targetValue   Float         // 目标值
  currentValue  Float         @default(0)  // 当前值
  unit          String?       // 单位
  startDate     DateTime      @default(now())
  endDate       DateTime?     // 结束日期
  subjectId     String?       // 关联科目
  status        GoalStatus    @default(active)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // 关系
  child         ChildAccount  @relation(fields: [childId], references: [id])
  subject       Subject?      @relation(fields: [subjectId], references: [id])
  progressRecords GoalProgressRecord[]

  @@index([childId])
  @@index([parentId])
  @@map("learning_goals")
}

// ============================================
// 目标进度记录 (GoalProgressRecord)
// ============================================

model GoalProgressRecord {
  id            String        @id @default(cuid())
  goalId        String
  value         Float         // 增量值
  note          String?       // 备注
  createdAt     DateTime      @default(now())

  // 关系
  goal          LearningGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_progress_records")
}

enum GoalType {
  daily    // 每日
  weekly   // 每周
  monthly  // 每月
  custom   // 自定义
}

enum GoalStatus {
  active      // 进行中
  paused      // 已暂停
  completed   // 已完成
  cancelled   // 已取消
}

// ============================================
// 学习报告系统
// ============================================

model LearningReport {
  id               String   @id @default(cuid())
  childId          String
  type             ReportType
  periodStart      DateTime
  periodEnd        DateTime
  totalQuestions   Int      @default(0)
  correctQuestions Int      @default(0)
  accuracyRate     Int      @default(0)
  totalPracticeTime Int?    // 总练习时长(秒)
  summary          String?  // 报告摘要
  subjectBreakdown Json?    // 科目分布详情
  masteredQuestions Int     @default(0)
  reviewedQuestions Int     @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // 关系
  child           ChildAccount @relation(fields: [childId], references: [id])

  @@index([childId])
  @@index([type])
  @@map("learning_reports")
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
}

// ============================================
// 举一反三题目系统 (Similar Questions)
// ============================================

model SimilarQuestion {
  id            String              @id @default(cuid())
  originalQuestionId String          // 原题ID
  childId       String              // 关联的孩子ID
  parentId      String              // 家长ID (用于权限验证)
  subjectId     String?             // 学科ID
  content       Json                // AI生成的变式题内容
  answer        Json?                // 变式题答案
  analysis      Json?                // 变式题解析
  triggerType   SimilarTriggerType   @default(MANUAL)  // 触发方式
  status        SimilarStatus       @default(PENDING)  // 生成状态
  modelUsed     String?             // 使用的AI模型
  promptUsed    String?             // 使用的提示词
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // 关联
  originalQuestion Question @relation(fields: [originalQuestionId], references: [id], onDelete: Cascade)
  child            ChildAccount @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([originalQuestionId])
  @@index([childId])
  @@index([parentId])
  @@index([status])
  @@map("similar_questions")
}

enum SimilarTriggerType {
  MANUAL         // 手动点击生成
  AUTO           // 错题入库自动生成
  BATCH          // 批量生成
}

enum SimilarStatus {
  PENDING        // 待生成
  GENERATING     // 生成中
  COMPLETED      // 已完成
  FAILED         // 生成失败
}

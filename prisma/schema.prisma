// HomeLearn - Prisma Schema
// 版本: V1.0 | 日期: 2026-05-11

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户与认证
// ============================================

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  username      String        @unique
  passwordHash  String
  role          UserRole      @default(PARENT)
  avatar        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // 关联
  children        ChildAccount[]
  questions       Question[]
  speechTemplates SpeechTemplate[]
  recordings      Recording[]
  accounts        Account[]
  sessions        Session[]
  
  @@map("users")
}

enum UserRole {
  PARENT      // 家长
  ADMIN       // 系统管理员(预留)
}

// NextAuth 适配器
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// 孩子账户
// ============================================

model ChildAccount {
  id            String        @id @default(cuid())
  userId        String
  nickname      String
  grade         Grade?
  avatar        String?
  preferences   Json?         // 学习偏好设置
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wrongQuestions WrongQuestion[]
  speechResults  SpeechResult[]
  reviewRecords  ReviewRecord[]
  practiceRecords PracticeRecord[]
  
  @@index([userId])
  @@map("child_accounts")
}

enum Grade {
  PRIMARY_1    // 小学一年级
  PRIMARY_2
  PRIMARY_3
  PRIMARY_4
  PRIMARY_5
  PRIMARY_6
  MIDDLE_1     // 初一
  MIDDLE_2
  MIDDLE_3
  HIGH_1       // 高一
  HIGH_2
  HIGH_3
}

// ============================================
// 学科与知识点
// ============================================

model Subject {
  id            String        @id @default(cuid())
  name          String        // 学科名称: 数学、英语、语文...
  code          String        @unique  // 代码: MATH, ENGLISH, CHINESE...
  icon          String?       // 图标URL
  color         String?       // 主题色
  order         Int          @default(0)
  
  questions     Question[]
  topics        Topic[]
  
  @@map("subjects")
}

model Topic {
  id            String        @id @default(cuid())
  subjectId     String
  name          String        // 知识点名称
  code          String?       // 知识点编码
  parentId      String?       // 父级知识点ID(支持多级)
  level         Int           @default(1)
  order         Int          @default(0)
  
  subject       Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent        Topic?       @relation("TopicHierarchy", fields: [parentId], references: [id])
  children      Topic[]      @relation("TopicHierarchy")
  questionTopics QuestionTopic[]
  
  @@index([subjectId])
  @@index([parentId])
  @@map("topics")
}

model Tag {
  id            String          @id @default(cuid())
  userId        String
  name          String
  color         String          @default("#3B82F6")
  type          TagType         @default(CUSTOM)
  createdAt     DateTime        @default(now())
  
  questionTags  QuestionTag[]
  
  @@unique([userId, name])
  @@map("tags")
}

enum TagType {
  CUSTOM       // 自定义标签
  DIFFICULTY   // 难度标签
  ERROR_TYPE   // 错因标签
}

// ============================================
// 题目系统
// ============================================

model Question {
  id            String          @id @default(cuid())
  userId        String
  subjectId     String
  type          QuestionType
  difficulty    Int             @default(3)  // 1-5星难度
  content       Json            // 富文本内容
  answer        Json            // 答案
  analysis      Json?           // 题目解析
  isPublic      Boolean         @default(false)
  version       Int             @default(1)
  status        QuestionStatus  @default(DRAFT)
  metadata      Json?           // 扩展字段
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject           @relation(fields: [subjectId], references: [id])
  versions        QuestionVersion[]
  wrongQuestions  WrongQuestion[]
  questionTopics  QuestionTopic[]
  questionTags    QuestionTag[]
  attachments     Attachment[]
  recordings      Recording[]
  
  @@index([userId])
  @@index([subjectId])
  @@index([difficulty])
  @@index([type])
  @@map("questions")
}

enum QuestionType {
  SINGLE_CHOICE    // 单选题
  MULTIPLE_CHOICE  // 多选题
  TRUE_FALSE       // 判断题
  FILL_BLANK       // 填空题
  SHORT_ANSWER     // 简答题
  CALCULATION      // 计算题
  PROOF            // 证明题
  COMPOSITION      // 作文
  READING          // 阅读理解
  LISTENING        // 听力题
}

enum QuestionStatus {
  DRAFT       // 草稿
  PUBLISHED   // 已发布
  ARCHIVED    // 已归档
}

model QuestionVersion {
  id            String        @id @default(cuid())
  questionId    String
  version       Int
  content       Json
  answer        Json
  analysis      Json?
  createdAt     DateTime      @default(now())
  
  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([questionId, version])
  @@index([questionId])
  @@map("question_versions")
}

model QuestionTopic {
  questionId    String
  topicId       String
  weight        Float         @default(1.0)
  
  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic         Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  @@id([questionId, topicId])
  @@map("question_topics")
}

model QuestionTag {
  questionId    String
  tagId         String
  
  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag           Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([questionId, tagId])
  @@map("question_tags")
}

model Attachment {
  id            String          @id @default(cuid())
  questionId    String
  type          AttachmentType
  filename      String
  url           String
  size          Int
  mimeType      String
  metadata      Json?
  createdAt     DateTime        @default(now())
  
  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@index([questionId])
  @@map("attachments")
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  GEOMETRY
  FORMULA
}

// ============================================
// 错题本系统
// ============================================

model WrongQuestion {
  id              String          @id @default(cuid())
  childId         String
  questionId      String
  source          WrongSource     @default(MANUAL)
  wrongAnswer     Json?
  mistakeReason   String?
  notes           String?
  mastered        Boolean         @default(false)
  masteryLevel    Int             @default(0)    // 0-5
  attempts        Int             @default(0)
  lastAttempt     DateTime?
  reviewCount     Int             @default(0)
  lastReview      DateTime?
  nextReview      DateTime?       // 艾宾浩斯下次复习时间
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  child           ChildAccount    @relation(fields: [childId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id])
  reviews         ReviewRecord[]
  
  @@index([childId])
  @@index([questionId])
  @@index([nextReview])
  @@map("wrong_questions")
}

enum WrongSource {
  MANUAL        // 手动添加
  PRACTICE      // 练习自动录入
  EXAM          // 考试录入
  IMPORT        // 批量导入
}

model ReviewRecord {
  id              String          @id @default(cuid())
  wrongQuestionId String
  childId         String
  reviewed        Boolean         // 是否真正掌握
  confidence      Int?            // 自信心评分 1-5
  notes           String?
  aiHelpUsed      Boolean         @default(false)
  reviewMethod    ReviewMethod?
  timeSpent       Int?            // 用时(秒)
  reviewedAt      DateTime        @default(now())
  
  wrongQuestion   WrongQuestion   @relation(fields: [wrongQuestionId], references: [id], onDelete: Cascade)
  child           ChildAccount    @relation(fields: [childId], references: [id])
  
  @@index([wrongQuestionId])
  @@index([childId])
  @@map("review_records")
}

enum ReviewMethod {
  SELF            // 自主复习
  AI_TUTOR        // AI讲解
  PARENT_TEACH    // 家长讲解
  VIDEO           // 视频讲解
  PRACTICE        // 练习巩固
}

// ============================================
// 练习记录
// ============================================

model PracticeRecord {
  id              String          @id @default(cuid())
  childId         String
  subjectId       String
  type            PracticeType
  totalQuestions  Int
  correctCount    Int
  duration        Int?            // 用时(秒)
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  
  child           ChildAccount    @relation(fields: [childId], references: [id])
  
  @@index([childId])
  @@map("practice_records")
}

enum PracticeType {
  FREE        // 自由练习
  EXAM        // 考试模式
  REVIEW      // 错题复习
  TARGETED    // 针对性练习
}

// ============================================
// 语音评测系统
// ============================================

model SpeechTemplate {
  id            String          @id @default(cuid())
  userId        String
  title         String
  content       String
  language      String          @default("en-US")
  type          SpeechType
  difficulty    Int?
  tags          String[]
  audioUrl      String?
  usageCount    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  results       SpeechResult[]
  
  @@index([userId])
  @@map("speech_templates")
}

enum SpeechType {
  WORD           // 单词
  SENTENCE       // 句子
  PARAGRAPH      // 段落
  DIALOGUE       // 对话
  PRONUNCIATION  // 发音练习
}

model SpeechResult {
  id              String          @id @default(cuid())
  templateId      String
  childId         String
  score           Float           // 总分 0-100
  accuracy        Float?
  fluency         Float?
  completeness    Float?
  prosody         Float?
  phonemeDetail   Json?
  feedback        Json?
  audioUrl        String?
  duration        Int?
  createdAt       DateTime        @default(now())
  
  template        SpeechTemplate  @relation(fields: [templateId], references: [id])
  child           ChildAccount    @relation(fields: [childId], references: [id])
  
  @@index([templateId])
  @@index([childId])
  @@map("speech_results")
}

// ============================================
// 家长讲解系统
// ============================================

model Recording {
  id            String          @id @default(cuid())
  userId        String
  questionId    String?
  type          RecordingType
  title         String
  description   String?
  url           String
  thumbnail     String?
  duration      Int?
  size          Int?
  views         Int             @default(0)
  likes         Int             @default(0)
  isPublic      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question?       @relation(fields: [questionId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([questionId])
  @@map("recordings")
}

enum RecordingType {
  VIDEO
  AUDIO
  SCREEN_RECORD
}

// ============================================
// 文言文系统
// ============================================

model ChineseText {
  id            String          @id @default(cuid())
  title         String
  author        String?
  dynasty       String?
  content       String          // 原文
  pinyin        String?         // 拼音
  translation   String?         // 白话文翻译
  annotation    Json?           // 注音和夹注
  layout        LayoutType      @default(HORIZONTAL)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@map("chinese_texts")
}

enum LayoutType {
  HORIZONTAL    // 横排
  VERTICAL      // 竖排(古典)
}

// ============================================
// AI 对话记录
// ============================================

model AIConversation {
  id            String          @id @default(cuid())
  childId       String
  subjectId     String?
  messages      Json            // 对话历史
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@index([childId])
  @@map("ai_conversations")
}
